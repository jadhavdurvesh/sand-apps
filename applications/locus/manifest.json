{
  "id": "locus",
  "name": "LOCUS",
  "version": "0.1.0",
  "description": "File explorer for browsing and organizing user data.",
  "phase": "core",
  "status": "host-prototype",
  "prototype": true,
  "entrypoint": "../../preview/index.html",
  "target": "host-preview",
  "sapp": "pending-abi",
  "capabilities": [
    "storage.read",
    "storage.write",
    "platform.files.read",
    "platform.files.write",
    "platform.window.create",
    "platform.notifications.create",
    "platform.desktop.events"
  ],
  "native": {
    "status": "windowed-v1",
    "source": "native/main.c",
    "console_source": "native-console/main.c",
    "abi": 3,
    "note": "Runs on SAND OS today through the kernel window service (run locus). A console variant is kept for serial sessions.",
    "launcher": {
      "label": "LOCUS",
      "subtitle": "Files",
      "accent": "#5CD6A0",
      "accent2": "#1E7A66",
      "glyph": "L",
      "order": 20
    }
  }
}
